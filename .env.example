# Optional advanced deployment configuration. First-use wizard normally configures storage and account.
# Percent-encode reserved characters in username/password. Database must already exist.
# Omit DATABASE_URL for wizard selection: local SQLite or creation of a new MySQL database.
# DATABASE_URL=mysql://chronicle_cartarium:change_this_database_password@127.0.0.1:3306/chronicle_cartarium_new_unique
# APP_PASSWORD=legacy_shared_password_only
# SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
PORT=3001
DATA_DIR=./data
NODE_ENV=production
# Set true behind HTTPS. Production defaults to true if omitted.
COOKIE_SECURE=false
# Set true only behind one trusted reverse proxy that preserves the Host header.
TRUST_PROXY=false

# Docker Compose database secrets; use distinct strong passwords.
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_PASSWORD=change_this_database_password
# Optional network/container bootstrap token (24+ random characters).
# Never expose this value publicly. Not needed for ordinary localhost installation.
# SETUP_TOKEN=replace_with_a_private_random_token
# CHRONICLE_CARTARIUM_SETUP_TOKEN=replace_with_a_private_random_token_for_compose
